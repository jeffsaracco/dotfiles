[
  {
    "defaults": {
      "link": {
        "create": true
      }
    }
  },
  {
    "create": [
      "~/.config",
      "~/.tmux",
      "~/workspace"
    ]
  },
  {
    "link": {
      "~/.agents": "home/agents",
      "~/.config/nvim": "home/config/nvim",
      "~/.config/opencode/opencode.json": "home/config/opencode/opencode.json",
      "~/.config/opencode/opencode.jsonc": "home/config/opencode/opencode.jsonc",
      "~/.config/opencode/oh-my-opencode-slim.json": "home/config/opencode/oh-my-opencode-slim.json",
      "~/.config/opencode/commands": "home/config/opencode/commands",
      "~/.config/opencode/skills": "home/config/opencode/skills",
      "~/.config/opencode/plugins": "home/config/opencode/plugins",
      "~/.config/opencode/tui.json": "home/config/opencode/tui.json",
      "~/.gitconfig": "home/git/gitconfig",
      "~/.gitignore_global": "home/git/gitignore_global",
      "~/.grc": "home/dotgrc",
      "~/.oh-my-zsh": "home/zsh/oh-my-zsh/upstream",
      "~/.tmux.conf": "home/tmux/tmux.conf",
      "~/.tmux/plugins/tpm": "home/tmux/plugins/tpm",
      "~/.zshrc": "home/zsh/zshrc"
    }
  }
]
