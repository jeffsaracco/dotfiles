#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WANT_DESKTOP=false
WANT_SERVICES=false

for profile in "$@"; do
  case "$profile" in
    base)
      ;;
    desktop)
      WANT_DESKTOP=true
      ;;
    services)
      WANT_SERVICES=true
      ;;
    -h|--help)
      printf 'Usage: %s [base] [desktop] [services]\n' "$0"
      exit 0
      ;;
    *)
      printf 'Unknown profile: %s\n' "$profile" >&2
      printf 'Usage: %s [base] [desktop] [services]\n' "$0" >&2
      exit 2
      ;;
  esac
done

case "$(uname -s)" in
  Darwin)
    if [[ "$(uname -m)" != "arm64" ]]; then
      printf 'This bootstrap supports Apple Silicon macOS only.\n' >&2
      exit 1
    fi
    "$ROOT/script/brewstrap.sh" "$WANT_DESKTOP" "$WANT_SERVICES"
    ;;
  Linux)
    if [[ ! -r /etc/os-release ]]; then
      printf 'Cannot identify this Linux distribution.\n' >&2
      exit 1
    fi
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-} ${ID_LIKE:-}" in
      *ubuntu*|*debian*)
        "$ROOT/script/install-apt.sh" "$WANT_DESKTOP" "$WANT_SERVICES"
        "$ROOT/script/install-neovim-linux.sh"
        if [[ "$WANT_DESKTOP" == true ]]; then
          "$ROOT/script/install-font-linux.sh"
        fi
        export PATH="$HOME/.local/bin:$PATH"
        ;;
      *)
        printf 'Only Ubuntu and Debian Linux are supported.\n' >&2
        exit 1
        ;;
    esac
    ;;
  *)
    printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2
    exit 1
    ;;
esac

if [[ -d "$HOME/.oh-my-zsh" && ! -L "$HOME/.oh-my-zsh" ]]; then
  backup="$HOME/.oh-my-zsh.backup.$(date +%Y%m%d%H%M%S)"
  mv "$HOME/.oh-my-zsh" "$backup"
  printf 'Moved the legacy Oh My Zsh checkout to %s.\n' "$backup"
fi

"$ROOT/script/run-dotbot.sh" "$ROOT/install.conf.json"

if [[ "$WANT_DESKTOP" == true ]]; then
  "$ROOT/script/run-dotbot.sh" "$ROOT/install.desktop.conf.json"
fi

umask 077
for local_config in "$HOME/.gitconfig.local" "$HOME/.zshrc.local"; do
  if [[ ! -e "$local_config" && ! -L "$local_config" ]]; then
    : > "$local_config"
  fi
done

if ! git config --file "$HOME/.gitconfig.local" --get user.name >/dev/null; then
  git config --file "$HOME/.gitconfig.local" user.name "Jeff Saracco"
fi
if ! git config --file "$HOME/.gitconfig.local" --get user.email >/dev/null; then
  git config --file "$HOME/.gitconfig.local" user.email "jeffsaracco@github.com"
fi

if [[ "$(uname -s)" == "Darwin" ]] &&
   ! git config --file "$HOME/.gitconfig.local" --get credential.helper >/dev/null; then
  git config --file "$HOME/.gitconfig.local" credential.helper osxkeychain
fi

"$ROOT/script/codespaces-setup.sh"
"$ROOT/script/install-vim-plugins.sh"

printf 'Dotfiles bootstrap completed.\n'
