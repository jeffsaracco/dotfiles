{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 3,
  "permission": {
    "edit": "ask",
    "skill": {
      "caveman": "allow",
      "caveman-commit": "allow",
      "caveman-review": "allow",
      "caveman-help": "allow",
      "caveman-compress": "allow"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "qwen3:8b",
          "contextWindow": 16384,
          "maxTokens": 4096,
          "tools": true
        }
      }
    }
  },
  "compaction": {
    "prune": false
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "instructions": [
    "~/.config/opencode/AGENTS.caveman.md"
  ],
  "shell": "zsh"
}
