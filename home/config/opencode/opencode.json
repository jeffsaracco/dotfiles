{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 3,
  "permission": {
    "edit": "ask"
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "qwen3:8b",
          "contextWindow": 16384,
          "maxTokens": 4096,
          "tools": true
        }
      }
    },
    "github-copilot": {
      "options": {
        "headers": {
          "sleev-provider": "copilot",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "openai": {
      "options": {
        "headers": {
          "sleev-provider": "codex",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "opencode": {
      "options": {
        "headers": {
          "sleev-provider": "opencode",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    }
  },
  "compaction": {
    "prune": false
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
