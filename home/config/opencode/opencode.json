{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 3,
  "permission": {
    "edit": "ask"
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "qwen3:8b",
          "contextWindow": 16384,
          "maxTokens": 4096,
          "tools": true
        }
      }
    }
  }
}
