{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jeff/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/rex-agent-restore' hook claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/jeff/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "ui-themes@ui-themes": true,
    "impeccable@impeccable": true,
    "godot-prompter@skillsmith": true,
    "mattpocock-skills@claude-plugins-official": true,
    "imessage@claude-plugins-official": true,
    "busybar@busybar": true
  },
  "extraKnownMarketplaces": {
    "awesome-claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "whyashthakker/awesome-claude-code-mods"
      }
    },
    "jeff-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/jeff/.claude/mods/session-meter"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "ui-themes": {
      "source": {
        "source": "github",
        "repo": "yugal1107/ui-themes"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "skillsmith": {
      "source": {
        "source": "github",
        "repo": "jame581/skillsmith"
      }
    },
    "counterparts": {
      "source": {
        "source": "github",
        "repo": "mlapeter/counterparts"
      },
      "autoUpdate": true
    },
    "busybar": {
      "source": {
        "source": "github",
        "repo": "mrlunev/busybar-claude-code"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "theme": "custom:ui-themes:claude-warm",
  "editorMode": "normal",
  "autoContinueAtUsageLimit": false,
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: private (jeffsaracco/wasteland-warriors, verified via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main; no rulesets or protected-branch rules listed via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (jeffsaracco/wasteland-warriors on github.com) and its origin remote only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Godot/GDScript game project — Wasteland Warriors)",
      "**Trusted repo**: jeffsaracco/wasteland-warriors (github.com:jeffsaracco/wasteland-warriors.git), working directory /Users/jeff/workspace/wasteland-warriors",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
