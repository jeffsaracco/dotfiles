#!/usr/bin/env bash

set -euo pipefail

for dependency in rg fzf jq; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf '%s is required.\n' "$dependency" >&2
    exit 127
  fi
done

if command -v bat >/dev/null 2>&1; then
  BAT=bat
elif command -v batcat >/dev/null 2>&1; then
  BAT=batcat
else
  printf 'bat or batcat is required.\n' >&2
  exit 127
fi

if [[ "$#" -eq 0 ]]; then
  printf 'Usage: rfv PATTERN [PATH ...]\n' >&2
  exit 2
fi

selected=""
IFS= read -r selected < <(
  rg --json --smart-case -- "$@" |
    jq -r 'select(.type == "match") | [.data.path.text, (.data.line_number | tostring), (.data.lines.text | rtrimstr("\n"))] | @tsv' |
    fzf --ansi \
      --color "hl:-1:underline,hl+:-1:underline:reverse" \
      --delimiter $'\t' \
      --with-nth 1,3.. \
      --preview "$BAT --color=always --highlight-line {2} -- {1}" \
      --preview-window 'up:60%:+{2}+3/3:~3'
)

if [[ -n "$selected" ]]; then
  IFS=$'\t' read -r file line _ <<< "$selected"
  editor="${EDITOR:-nvim}"
  "$editor" "$file" "+$line"
fi
